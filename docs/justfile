# Local patched fork (see .dioxus-fork/BUGS.md), tracking dioxus's real
# `main` (not the v0.7.10 we depend on - dx isn't tightly version-locked to
# it, just warns on the mismatch) plus our own still-needed fixes on top.
# Not checked in; rebuild with `just build-dx` after pulling fork changes.
dx := justfile_directory() / ".." / ".dioxus-fork" / "target" / "release" / "dx"

start:
    {{dx}} serve --platform web --debug-symbols=false --hotpatch

start_release:
    {{dx}} serve --platform web --debug-symbols=false --release --hot-patch false --wasm-split --features wasm-split

public := justfile_directory() / ".." / "target" / "dx" / "docs"

build:
    {{dx}} build --platform web --debug-symbols=false
    ./preload_wasm.sh {{public}}/debug/web/public

build_release:
    {{dx}} build --platform web --debug-symbols=false --release --wasm-split --features wasm-split
    ./preload_wasm.sh {{public}}/release/web/public

# Serve a built bundle with brotli/gzip content negotiation, the way a real
# static host would. `dx serve` skips the preload step and `python3 -m
# http.server` ignores the precompressed siblings, so neither is measurable.
serve_dist port="8080":
    ./serve_dist.py {{public}}/release/web/public {{port}}

# Rebuild the local dx binary from .dioxus-fork (branch fix/combined)
build-dx:
    cd {{justfile_directory() / ".." / ".dioxus-fork"}} && cargo build --release -p dioxus-cli --bin dx
