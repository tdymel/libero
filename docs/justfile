root := justfile_directory() / ".."

# `dx` has to match the lockfile's dioxus (version, and rev for a git source) - a
# mismatch means wire-protocol skew - so `$DX`, else `just install-dx`'s cargo
# copy, which a package-manager `dx` on PATH would shadow.
cargo_dx := env_var_or_default("CARGO_HOME", home_directory() / ".cargo") / "bin" / "dx"
dx := env_var_or_default("DX", if path_exists(cargo_dx) == "true" { cargo_dx } else { "dx" })
dioxus_version := `awk '/^name = "dioxus"$/ { getline; gsub(/"/, "", $3); print $3; exit }' ../Cargo.lock`
# Empty for a crates.io dioxus.
dioxus_rev := `awk '/^name = "dioxus"$/ { f = 1 } f && /^source = "git\+/ { n = split($3, a, "#"); gsub(/"/, "", a[n]); print a[n]; exit } f && /^$/ { exit }' ../Cargo.lock`
# `dx --version` of a matching dx; a stale git build of the same version differs only in the rev.
dx_wanted := "dioxus " + dioxus_version + if dioxus_rev == "" { "" } else { " (" + replace_regex(dioxus_rev, "^(.{7}).*", "$1") + ")" }

import 'native.just'
import 'desktop.just'
import 'android.just'

# Target dir `target/main`, so `cargo` picks it up too - not just these recipes.
# Host builds (tests, native) link with mold: linking the test binaries is most
# of an incremental rebuild. wasm keeps rust-lld, since the flag is host-only.
cargo-config:
    mkdir -p {{root}}/.cargo
    printf '# Written by `just cargo-config` - do not edit.\n[build]\ntarget-dir = "target/main"\n\n[target.x86_64-unknown-linux-gnu]\nrustflags = ["-C", "link-arg=-fuse-ld=mold"]\n' > {{root}}/.cargo/config.toml

# The whole workspace.
test:
    cd {{root}} && cargo test --workspace

# An older `dx` (0.7.10 from a package manager) refuses the workspace.
_dx:
    @{{dx}} --version | {{ if dioxus_rev == "" { "grep -qE '^" + replace(dx_wanted, ".", "\\.") + "( \\(.*\\))?$'" } else { "grep -qxF '" + dx_wanted + "'" } }} || (echo "{{dx}} ($({{dx}} --version)) is not {{dx_wanted}} - run \`just install-dx\`" && exit 1)

start: _dx
    {{dx}} serve --platform web --debug-symbols=false --hotpatch

# UI loop without hot-patching: a ~50 MB wasm instead of ~270 MB, full rebuild on save.
# `wasm-dev` already drops debug info, so no extra profile (todo 3888).
ui: _dx
    {{dx}} serve --platform web --hot-patch false

ffeat := "--features fullstack"

# The same web app, server-rendered and hydrated. `dx` builds the client and
# a server binary and serves both; no `--platform` guess is involved because
# `--fullstack` pins it.
start-fullstack: _dx
    {{dx}} serve --platform web --fullstack --debug-symbols=false {{ffeat}}

# Compile-only check of both halves - the server half is the one that can
# break, since it builds libero for a non-wasm, non-Blitz target.
check-fullstack:
    cd {{root}} && cargo check -p docs {{ffeat}}
    cd {{root}} && cargo check -p docs {{ffeat}},dioxus/server

start_release: _dx
    {{dx}} serve --platform web --debug-symbols=false --release --hot-patch false

public := root / "target" / "main" / "dx" / "docs"

build: _dx
    {{dx}} build --platform web --debug-symbols=false
    ./preload_wasm.sh {{public}}/debug/web/public

build_release: _dx
    {{dx}} build --platform web --debug-symbols=false --release
    ./preload_wasm.sh {{public}}/release/web/public
    # As pages.yml: the 404 shell and one `<route>.html` per route.
    cp {{public}}/release/web/public/index.html {{public}}/release/web/public/404.html
    ./route_pages.py {{public}}/release/web/public

# Serve a built bundle with brotli/gzip content negotiation, the way a real
# static host would. `dx serve` skips the preload step and `python3 -m
# http.server` ignores the precompressed siblings, so neither is measurable.
serve_dist port="8080":
    ./serve_dist.py {{public}}/release/web/public {{port}}

# `dx` from the lockfile's dioxus version or rev, as ci.yml's e2e job installs it.
install-dx:
    cargo install dioxus-cli {{ if dioxus_rev == "" { "--version " + dioxus_version } else { "--git https://github.com/DioxusLabs/dioxus --rev " + dioxus_rev } }} --locked --bin dx --force
