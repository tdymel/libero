root := justfile_directory() / ".."

# Both crates path-depend on `../.dioxus-active`, a symlink pointing at either
# `.dioxus-main` (upstream, the default) or `.dioxus-fork` (upstream plus our
# still-needed fixes - see .dioxus-fork/BUGS.md). `just mode-main`/`mode-fork`
# flip it, and give each mode its own target dir so switching doesn't rebuild
# the world. `dx` resolves through the same symlink, so the CLI and the crate
# it builds always come from one tree - the versions aren't tightly locked,
# but a mismatch means wire-protocol skew. Neither tree is checked in; rebuild
# the active one's CLI with `just build-dx`.
dx := root / ".dioxus-active" / "target" / "release" / "dx"

import 'native.just'
import 'android.just'

# Fork-only APIs are behind libero's `dioxus-fork` feature, so every recipe
# below picks its flags from the active mode. Wrong mode = compile error.
# `readlink -f`, not `readlink`: a worktree's `.dioxus-active` is a symlink to
# the main checkout's `.dioxus-active`, so one hop only prints that path and
# every worktree would read as main mode - and then build the fork tree with
# the main arm, which compiles silently. Resolve the whole chain and match the
# basename.
fork := `test "$(basename "$(readlink -f ../.dioxus-active)")" = .dioxus-fork && echo 1 || echo ""`
feat := if fork == "1" { "--features dioxus-fork" } else { "" }
# --wasm-split needs the fork's wasm-split-cli fixes, and docs' `wasm-split`
# feature already implies `dioxus-fork` - so this replaces `feat`, not adds.
split := if fork == "1" { "--wasm-split --features wasm-split" } else { "" }

# Build against upstream dioxus main (default).
mode-main:
    ln -sfn .dioxus-main {{root}}/.dioxus-active
    @just _target-dir main

# Build against .dioxus-fork (fix/combined) and its fork-only APIs.
mode-fork:
    ln -sfn .dioxus-fork {{root}}/.dioxus-active
    @just _target-dir fork

# Per-mode target dir, so `cargo` picks it up too - not just these recipes.
# Host builds (tests, native) link with mold: linking the test binaries is most
# of an incremental rebuild. wasm keeps rust-lld, since the flag is host-only.
# The toolchain is nightly (rust-toolchain.toml) for two things: rustc's
# parallel frontend (`-Z threads`), since `libero` is one large crate, and
# cargo's checksum freshness, so a seat moved to a newer main rebuilds only
# files whose content changed, not every file git touched. A target's
# rustflags replace `[build]` ones rather than adding to them, hence the flag
# on each target.
_target-dir mode:
    mkdir -p {{root}}/.cargo
    printf '# Written by `just mode-main` / `just mode-fork` - do not edit.\n[build]\ntarget-dir = "target/%s"\n\n[unstable]\nchecksum-freshness = true\n\n[target.x86_64-unknown-linux-gnu]\nrustflags = ["-C", "link-arg=-fuse-ld=mold", "-Z", "threads=8"]\n\n[target.wasm32-unknown-unknown]\nrustflags = ["-Z", "threads=8"]\n' {{mode}} > {{root}}/.cargo/config.toml
    @echo "mode: {{mode}}"

# Which tree is active, and does the feature flag follow it.
mode:
    @echo "tree:    $(basename "$(readlink -f {{root}}/.dioxus-active)")"
    @echo "flags:   {{feat}}"

# The whole workspace, in the active mode.
test:
    cd {{root}} && cargo test --workspace {{ if fork == "1" { "--features libero/dioxus-fork" } else { "" } }}

# Fails with a bare `No such file` otherwise - each tree's dx is built once.
_dx:
    @test -x {{dx}} || (echo "no dx in $(basename "$(readlink -f {{root}}/.dioxus-active)") - run \`just build-dx\`" && exit 1)

start: _dx
    {{dx}} serve --platform web --debug-symbols=false --hotpatch {{feat}}

ffeat := "--features " + if fork == "1" { "fullstack,dioxus-fork" } else { "fullstack" }

# The same web app, server-rendered and hydrated. `dx` builds the client and
# a server binary and serves both; no `--platform` guess is involved because
# `--fullstack` pins it.
start-fullstack: _dx
    {{dx}} serve --platform web --fullstack --debug-symbols=false {{ffeat}}

# Compile-only check of both halves - the server half is the one that can
# break, since it builds libero for a non-wasm, non-Blitz target.
check-fullstack:
    cd {{root}} && cargo check -p docs {{ffeat}}
    cd {{root}} && cargo check -p docs {{ffeat}},dioxus/server

start_release: _dx
    {{dx}} serve --platform web --debug-symbols=false --release --hot-patch false {{split}}

public := root / "target" / (if fork == "1" { "fork" } else { "main" }) / "dx" / "docs"

build: _dx
    {{dx}} build --platform web --debug-symbols=false {{feat}}
    ./preload_wasm.sh {{public}}/debug/web/public

build_release: _dx
    {{dx}} build --platform web --debug-symbols=false --release {{split}}
    ./preload_wasm.sh {{public}}/release/web/public

# Serve a built bundle with brotli/gzip content negotiation, the way a real
# static host would. `dx serve` skips the preload step and `python3 -m
# http.server` ignores the precompressed siblings, so neither is measurable.
serve_dist port="8080":
    ./serve_dist.py {{public}}/release/web/public {{port}}

# Rebuild the dx binary from whichever tree is active. Each tree keeps its own
# target/, so both binaries survive a mode flip.
build-dx:
    cd {{root}}/.dioxus-active && cargo build --release -p dioxus-cli --bin dx
