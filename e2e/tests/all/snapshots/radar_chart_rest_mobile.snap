---
source: e2e/src/suite.rs
description: radar_chart at mobile (rest)
expression: tree
---
figure "Cars"
  description "Radar chart over 4 axes: Speed, Power, Range, Cost. X: highest on Speed, 8 of 10; lowest on Range, 7 of 20. Y: highest on Range, 18 of 20; lowest on Cost, 4 of 10. Y: no value on Power, drawn at the centre."
  StaticText "Cars"
  application "Cars" [roledescription=chart]
    description "Arrow keys move between points, Home and End to the first and last. Up and down move between series. Enter selects one."
  status [atomic] [live=polite]
  list "Series"
    listitem [level=1]
      button "X" [pressed]
        StaticText "X"
    listitem [level=1]
      button "Y" [pressed]
        StaticText "Y"
  paragraph
    StaticText "Radar chart over 4 axes: Speed, Power, Range, Cost."
  paragraph
    StaticText "X: highest on Speed, 8 of 10; lowest on Range, 7 of 20."
  paragraph
    StaticText "Y: highest on Range, 18 of 20; lowest on Cost, 4 of 10."
  paragraph
    StaticText "Y: no value on Power, drawn at the centre."
paragraph
paragraph
paragraph
