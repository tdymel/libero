---
source: e2e/src/suite.rs
description: video at mobile (rest)
expression: tree
---
paragraph
  StaticText "A silent clip with subtitles, and one without."
group "Silence"
  Video
  group "Player controls"
    button "Play"
    slider "Seek" = 0 [valuemax=4] [valuemin=0]
    button "Mute"
    button "Playback speed 1×" [expanded=false] [haspopup=menu]
      StaticText "1×"
    button "Captions" [pressed=false]
    button "Fullscreen"
  status [atomic] [live=polite]
group "Plain"
  Video
  group "Player controls"
    button "Play"
    slider "Seek" = 0 [valuemax=4] [valuemin=0]
    button "Mute"
    button "Playback speed 1×" [expanded=false] [haspopup=menu]
      StaticText "1×"
    button "Captions" [disabled] [pressed=false]
    StaticText "No captions for this video"
    button "Fullscreen"
  status [atomic] [live=polite]
tooltip "Play K"
  StaticText "Play"
  StaticText "K"
