---
source: e2e/src/suite.rs
description: video at desktop (rest)
expression: tree
---
paragraph
  StaticText "A silent clip with subtitles, and one without."
group "Silence"
  Video
  group "Player controls"
    slider "Seek" = 0 [orientation=horizontal] [valuemax=4] [valuemin=0]
      description "0:00 of 0:04"
    button "Play" [keyshortcuts=K]
    button "Mute" [keyshortcuts=M]
    button "Volume" [expanded=false] [haspopup=dialog]
    button "Captions" [keyshortcuts=C] [pressed=false]
    button "Playback speed 1×" [expanded=false] [haspopup=menu]
      StaticText "1×"
    button "Fullscreen" [keyshortcuts=F]
  status [atomic] [live=polite]
group "Plain"
  Video
  group "Player controls"
    slider "Seek" = 0 [orientation=horizontal] [valuemax=4] [valuemin=0]
      description "0:00 of 0:04"
    button "Play" [keyshortcuts=K]
    button "Mute" [keyshortcuts=M]
    button "Volume" [expanded=false] [haspopup=dialog]
    button "Captions" [disabled] [pressed=false]
      description "No captions for this video"
    StaticText "No captions for this video"
    button "Playback speed 1×" [expanded=false] [haspopup=menu]
      StaticText "1×"
    button "Fullscreen" [keyshortcuts=F]
  status [atomic] [live=polite]
tooltip "Play K"
  StaticText "Play"
  StaticText "K"
