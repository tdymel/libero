---
source: e2e/src/suite.rs
description: pie_chart at desktop (rest)
expression: tree
---
figure "Browsers"
  description "Pie chart, total 100. Chrome: 60, 60%. Safari: 25, 25%. Other: 15, 15%."
  StaticText "Browsers"
  application "Browsers" [roledescription=chart]
    description "Arrow keys move between points, Enter selects one."
  status [atomic] [live=polite]
  list "Slices"
    listitem [level=1]
      button "Chrome" [pressed]
        StaticText "Chrome"
    listitem [level=1]
      button "Safari" [pressed]
        StaticText "Safari"
    listitem [level=1]
      button "Other" [pressed]
        StaticText "Other"
  paragraph
    StaticText "Pie chart, total 100."
  paragraph
    StaticText "Chrome: 60, 60%."
  paragraph
    StaticText "Safari: 25, 25%."
  paragraph
    StaticText "Other: 15, 15%."
  table "Browsers"
    caption
      StaticText "Browsers"
    rowgroup
      row
        columnheader "Category"
          StaticText "Category"
        columnheader "Value"
          StaticText "Value"
        columnheader "Share"
          StaticText "Share"
    row
      rowheader "Chrome"
        StaticText "Chrome"
      cell "60"
        StaticText "60"
      cell "60%"
        StaticText "60%"
    row
      rowheader "Safari"
        StaticText "Safari"
      cell "25"
        StaticText "25"
      cell "25%"
        StaticText "25%"
    row
      rowheader "Other"
        StaticText "Other"
      cell "15"
        StaticText "15"
      cell "15%"
        StaticText "15%"
paragraph
paragraph
paragraph
